<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!--
          Tu khoi tao SDK tu <meta-data android:name="vn.fpt.cmp.codeConfig" ...> cua app.
          Authority gan theo applicationId de nhieu app cung dung SDK van cai chung may duoc.
          App muon tat: khai lai provider nay voi tools:node="remove".
        -->
        <provider
            android:name="vn.fpt.fis.cmp.consent.ConsentInitProvider"
            android:authorities="${applicationId}.cmp-init"
            android:exported="false" />
    </application>

</manifest>
