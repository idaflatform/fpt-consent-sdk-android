<?xml version="1.0" encoding="utf-8"?>
<!-- Vỏ bottom sheet: trạng thái đang tải / lỗi / thử lại do ConsentFormView tự hiện. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cmp_bg_sheet">

    <ScrollView
        android:id="@+id/cmp_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:padding="@dimen/cmp_space_lg">

        <vn.fpt.fis.cmp.consent.ui.ConsentFormView
            android:id="@+id/cmp_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</FrameLayout>
