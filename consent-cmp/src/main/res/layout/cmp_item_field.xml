<?xml version="1.0" encoding="utf-8"?>
<!--
  Mot truong du lieu, bam de chon / bo chon. CheckedTextView: TalkBack doc trang thai "da chon".
  Man hep: chip (nen cmp_bg_field_chip + dau check khi chon). Man rong: checkbox (icon trai, khong nen).
  ConsentFormView dat nen / icon theo che do.
-->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkMark="@null"
    android:drawablePadding="6dp"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:textColor="@color/cmp_text_primary"
    android:textSize="@dimen/cmp_text_body" android:tag="cmp::cmp_text_primary" />
