<?xml version="1.0" encoding="utf-8"?>
<!-- Chip truong du lieu (man hep): da chon = nen xanh nhat + vien xanh. Khong dung ripple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cmp_primary_soft" />
            <stroke android:width="1dp" android:color="@color/cmp_primary_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cmp_bg" />
            <stroke android:width="1dp" android:color="@color/cmp_field_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
