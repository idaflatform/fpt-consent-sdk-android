<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/cmp_switch_track_off" />
            <corners android:radius="@dimen/cmp_radius_field" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cmp_primary_pressed" />
            <corners android:radius="@dimen/cmp_radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cmp_primary" />
            <corners android:radius="@dimen/cmp_radius_field" />
        </shape>
    </item>
</selector>
