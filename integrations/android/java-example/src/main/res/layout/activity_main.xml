<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đăng ký mẫu với CMP" android:textSize="22sp"/>
  <EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" android:tag="Email|EMAIL" android:text="demo@example.invalid"/>
  <EditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="PhoneNumber" android:inputType="phone" android:tag="PhoneNumber"/>
  <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true"/>
  <vn.fpt.fis.cmp.consent.ui.ConsentFormView android:id="@+id/consent_form" android:layout_width="match_parent" android:layout_height="wrap_content" app:cmpEmbeddedInForm="true" app:cmpAutoLoad="false"/>
  <Button android:id="@+id/submit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gửi consent trước khi đăng ký" android:enabled="false"/>
  <Button android:id="@+id/standalone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở màn consent độc lập"/>
  <Button android:id="@+id/clear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đăng xuất và xóa quyết định"/>
 </LinearLayout>
</ScrollView>
