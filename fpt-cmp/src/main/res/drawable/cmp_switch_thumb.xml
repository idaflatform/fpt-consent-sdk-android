<?xml version="1.0" encoding="utf-8"?>
<!--
  Thumb 20dp, cach mep track 3dp tren/duoi, 2dp trai/phai -> kich thuoc 24x26dp (2 x 24 = 48dp = rong
  track). Dung layer-list chu khong dung inset: SwitchCompat coi inset cua InsetDrawable la padding
  va keo thumb lech ra ngoai track.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</layer-list>
